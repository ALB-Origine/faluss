{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faluss.example/faluss-federation-response.schema.json",
  "title": "Faluss Federation FED-01A response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "message_type", "request_id", "request_body_sha256", "responder", "recipient", "generated_at", "expires_at", "status", "payload_contract", "payload", "error"],
  "properties": {
    "protocol_version": { "const": "1" },
    "message_type": { "const": "response" },
    "request_id": { "$ref": "#/$defs/uuidV4" },
    "request_body_sha256": { "$ref": "#/$defs/sha256" },
    "responder": { "$ref": "#/$defs/responder" },
    "recipient": { "$ref": "#/$defs/recipient" },
    "generated_at": { "$ref": "#/$defs/rfc3339Utc" },
    "expires_at": { "$ref": "#/$defs/rfc3339Utc" },
    "status": { "enum": ["success", "empty", "not_available", "not_authorized", "incompatible", "temporarily_unavailable", "invalid_request", "replay_rejected"] },
    "payload_contract": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/payloadContract" }] },
    "payload": { "type": "object", "maxProperties": 128 },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/publicError" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
      "then": {
        "properties": { "payload_contract": { "$ref": "#/$defs/payloadContract" }, "payload": { "type": "object", "minProperties": 1 }, "error": { "const": null } }
      }
    },
    {
      "if": { "properties": { "status": { "const": "empty" } }, "required": ["status"] },
      "then": { "properties": { "payload_contract": { "const": null }, "payload": { "const": {} }, "error": { "const": null } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["not_available", "not_authorized", "incompatible", "temporarily_unavailable", "invalid_request", "replay_rejected"] } }, "required": ["status"] },
      "then": { "properties": { "payload_contract": { "const": null }, "payload": { "const": {} } } }
    }
  ],
  "$defs": {
    "uuidV4": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rfc3339Utc": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 32 },
    "semanticVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "nodeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "appKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" },
    "responder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "app_key", "key_id"],
      "properties": { "node_id": { "$ref": "#/$defs/nodeId" }, "app_key": { "$ref": "#/$defs/appKey" }, "key_id": { "$ref": "#/$defs/keyId" } }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "app_key"],
      "properties": { "node_id": { "$ref": "#/$defs/nodeId" }, "app_key": { "$ref": "#/$defs/appKey" } }
    },
    "payloadContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "contract_version"],
      "properties": { "document_type": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}(?:\\.[a-z][a-z0-9-]{1,63})+$", "maxLength": 128 }, "contract_version": { "$ref": "#/$defs/semanticVersion" } }
    },
    "publicError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": { "code": { "enum": ["not_available", "not_authorized", "incompatible", "temporarily_unavailable", "invalid_request", "replay_rejected"] }, "message": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\r\\n]+$" } }
    }
  },
  "x-fed01a-transport": {
    "method": "POST",
    "path": "/wp-json/faluss-federation/v1/exchange",
    "signature_algorithm": "Ed25519",
    "signature_encoding": "base64url-no-padding",
    "response_max_lifetime_seconds": 300,
    "required_response_headers": { "Cache-Control": "private, no-store", "X-Content-Type-Options": "nosniff" },
    "sodium_unavailable": "fail_closed"
  },
  "x-fed01a-semantic-invariants": {
    "canonical_response_components": ["protocol_version", "HTTP_status", "request_id", "request_body_sha256", "responder.node_id", "recipient.node_id", "responder.key_id", "generated_at", "expires_at", "raw_response_sha256_hex"],
    "consumer_must_verify": ["responder_identity", "key_state", "signature", "request_id", "request_body_sha256", "recipient", "freshness", "specialized_payload_contract"],
    "failure_behavior": "absent_invalid_expired_incompatible_or_nonconform_response_is_omitted_without_direct_read_old_cache_or_invented_value",
    "audit_allowlist": ["request_id", "sender_node_id", "recipient_node_id", "operation", "capability_key", "non_sensitive_result", "utc_timestamp", "duration", "opaque_diagnostic_code"],
    "audit_forbidden": ["faluss_id", "raw_body", "payload", "signature", "key_material", "nonce", "email", "session", "member_url", "payment", "private_content"]
  },
  "x-fed01a-scope": ["docs/FALUSS_FEDERATION_CONTRACT.md", "contracts/faluss-federation-request.schema.json", "contracts/faluss-federation-response.schema.json", "tests/faluss-federation-fed01a-contract-test.php", "docs/FALUSS_CAPABILITIES_CONTRACT.md", "docs/MASTER_PROFILE_CONTRACT.md", "docs/ARCHITECTURE.md", "docs/DATA_MODEL.md", "docs/ROADMAP.md"]
}
