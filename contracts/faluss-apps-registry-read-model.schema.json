{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faluss.com/capabilities/v1/faluss-apps-registry-read-model.schema.json",
  "title": "Faluss apps.registry read-model v1",
  "description": "CAP-01A contract only. This filtered document carries no faluss_id, WordPress identifier, session, payment, balance or executable content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "namespace",
    "consumer",
    "freshness",
    "source",
    "applications",
    "compatibility"
  ],
  "properties": {
    "contract_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "namespace": {
      "const": "apps.registry"
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "consumer_version"],
      "properties": {
        "surface": {
          "enum": ["portal", "master_profile", "me"]
        },
        "consumer_version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "engine", "read_model", "source_version"],
      "properties": {
        "type": { "const": "registry_read_model" },
        "engine": { "const": "faluss-apps-registry" },
        "read_model": { "const": "apps-registry" },
        "source_version": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "applications": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/application"
      }
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "appKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "capabilityKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}(?:\\.[a-z][a-z0-9_.-]{1,127})+$"
    },
    "engineId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "interface": {
      "enum": ["module_read_model", "delegated_action", "event_source", "content_reference_source"]
    },
    "slot": {
      "enum": [
        "portal.apps.card_action",
        "portal.analytics.dataset",
        "master_profile.module",
        "master_profile.footer_action",
        "me.studio.tab",
        "me.studio.block_source",
        "me.public.tab",
        "me.public.block",
        "analytics.events",
        "quests.events",
        "progression.events"
      ]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "max_age_seconds", "stale_behavior"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "max_age_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "stale_behavior": { "enum": ["omit", "refresh_from_owner"] }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_consumer_version", "compatible_with", "deprecated", "sunset_at"],
      "properties": {
        "minimum_consumer_version": { "$ref": "#/$defs/semanticVersion" },
        "compatible_with": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/semanticVersion" }
        },
        "deprecated": { "type": "boolean" },
        "sunset_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        }
      }
    },
    "specializedReadModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "freshness"],
      "properties": {
        "status": {
          "enum": ["available", "unavailable", "expired", "not_supported"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "read_model", "source_version"],
          "properties": {
            "engine": { "$ref": "#/$defs/engineId" },
            "read_model": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}(?:\\.[a-z][a-z0-9-]{1,63})*$"
            },
            "source_version": { "$ref": "#/$defs/semanticVersion" }
          }
        },
        "freshness": { "$ref": "#/$defs/freshness" }
      }
    },
    "surfaceCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "consumer_version"],
      "properties": {
        "status": { "enum": ["compatible", "incompatible", "unsupported"] },
        "consumer_version": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "activeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "interface", "binding_state"],
      "properties": {
        "slot": { "$ref": "#/$defs/slot" },
        "interface": { "$ref": "#/$defs/interface" },
        "binding_state": { "const": "active" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "interface": { "const": "event_source" } },
            "required": ["interface"]
          },
          "then": {
            "properties": {
              "slot": {
                "enum": ["analytics.events", "quests.events", "progression.events"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "slot": {
                "enum": ["analytics.events", "quests.events", "progression.events"]
              }
            },
            "required": ["slot"]
          },
          "then": {
            "properties": {
              "interface": { "const": "event_source" }
            }
          }
        }
      ]
    },
    "allowedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_key", "owner", "delegation"],
      "properties": {
        "action_key": { "$ref": "#/$defs/capabilityKey" },
        "owner": { "$ref": "#/$defs/engineId" },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target"],
          "properties": {
            "type": { "const": "owner_delegated_action" },
            "target": { "$ref": "#/$defs/capabilityKey" }
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_key",
        "owner",
        "interfaces",
        "state",
        "specialized_read_model",
        "surface_compatibility",
        "active_bindings",
        "allowed_actions"
      ],
      "properties": {
        "capability_key": { "$ref": "#/$defs/capabilityKey" },
        "owner": { "$ref": "#/$defs/engineId" },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/interface" }
        },
        "state": {
          "enum": ["enabled", "disabled", "temporarily_unavailable", "not_supported"]
        },
        "specialized_read_model": { "$ref": "#/$defs/specializedReadModel" },
        "surface_compatibility": { "$ref": "#/$defs/surfaceCompatibility" },
        "active_bindings": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/activeBinding" }
        },
        "allowed_actions": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/allowedAction" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "enum": ["disabled", "temporarily_unavailable", "not_supported"] } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "active_bindings": { "maxItems": 0 },
              "allowed_actions": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "specialized_read_model": { "properties": { "status": { "enum": ["unavailable", "expired", "not_supported"] } } } },
            "required": ["specialized_read_model"]
          },
          "then": {
            "properties": {
              "active_bindings": { "maxItems": 0 },
              "allowed_actions": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "surface_compatibility": { "properties": { "status": { "enum": ["incompatible", "unsupported"] } } } },
            "required": ["surface_compatibility"]
          },
          "then": {
            "properties": {
              "active_bindings": { "maxItems": 0 },
              "allowed_actions": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_key", "availability", "member_relationship", "capabilities"],
      "properties": {
        "app_key": { "$ref": "#/$defs/appKey" },
        "availability": { "enum": ["available", "unavailable", "retired"] },
        "member_relationship": { "enum": ["active", "inactive", "not_linked"] },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": { "enum": ["unavailable", "retired"] }
            },
            "required": ["availability"]
          },
          "then": {
            "properties": {
              "capabilities": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/capability" },
                    { "$ref": "#/$defs/noActiveOutputs" }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "member_relationship": { "enum": ["inactive", "not_linked"] }
            },
            "required": ["member_relationship"]
          },
          "then": {
            "properties": {
              "capabilities": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/capability" },
                    { "$ref": "#/$defs/noActiveOutputs" }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "noActiveOutputs": {
      "type": "object",
      "properties": {
        "active_bindings": { "maxItems": 0 },
        "allowed_actions": { "maxItems": 0 }
      }
    }
  },
  "x-semantic-invariants": {
    "server_validation_required": true,
    "on_violation": "reject",
    "registry": {
      "app_key_unique": {
        "collection": "applications",
        "unique_by": ["app_key"]
      },
      "capability_key_unique": {
        "collection": "applications[].capabilities",
        "unique_by": ["capability_key"]
      },
      "active_binding_slot_interface_unique": {
        "collection": "applications[].capabilities[].active_bindings",
        "unique_by": ["slot", "interface"]
      },
      "allowed_action_key_unique": {
        "collection": "applications[].capabilities[].allowed_actions",
        "unique_by": ["action_key"]
      },
      "capability_namespace_ownership": {
        "collection": "applications[].capabilities",
        "capability_key_prefix": "application.app_key + '.'"
      },
      "active_binding_interface_declared_by_capability": {
        "collection": "applications[].capabilities[].active_bindings",
        "must_be_member_of": "application.capabilities[].interfaces"
      },
      "specialized_read_model_source_owner_match": {
        "collection": "applications[].capabilities",
        "left": "specialized_read_model.source.engine",
        "equals": "owner"
      },
      "allowed_action_owner_match": {
        "collection": "applications[].capabilities[].allowed_actions",
        "left": "owner",
        "equals": "capability.owner"
      }
    }
  }
}
